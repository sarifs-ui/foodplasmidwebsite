# Every setting has a working default, so the application runs with no .env
# file at all. Copy this to backend/.env only to override something.

# Port for the API and the built web UI (they share one port).
PORT=4000

# Sample table produced by `npm run import-data`.
SAMPLES_PATH=data/gfpr.json

# Precomputed figure payloads, committed to the repository.
DERIVED_PATH=data/gfpr.derived.json

# Optional gene-level annotation database produced by `npm run import-annotations`.
ANNOTATIONS_DB_PATH=data/gfpr.db

# Directory holding the source CSVs.
DATA_DIR=data

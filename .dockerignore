# Keep the build context small.

.git
.gitignore
.dockerignore
Dockerfile
docker-compose.yml
README.md

node_modules
**/node_modules
frontend/dist
backend/.env

*.log
npm-debug.log*
.vscode
.idea
.DS_Store

# Windows download artefacts and Office lock files
~$*
*:Zone.Identifier

# backend/data holds several hundred megabytes of optional source files and a
# generated database. Only the small gzipped tables the image needs get through.
# (Docker's matcher requires the dir/* + !dir/file form.)
backend/data/*
!backend/data/metadata.csv.gz
!backend/data/chord.csv.gz
!backend/data/amr-rgi-consensus.csv.gz
!backend/data/cazyme.csv.gz
!backend/data/amp_all.csv.gz
!backend/data/cctyper.csv.gz
!backend/data/acp_all.csv.gz
!backend/data/gfpr.derived.json.gz

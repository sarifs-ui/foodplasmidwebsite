# Keep the build context small.

.git
.gitignore
.dockerignore
Dockerfile
docker-compose.yml
README.md

node_modules
**/node_modules
frontend/dist
backend/.env

*.log
npm-debug.log*
.vscode
.idea
.DS_Store

# Windows download artefacts and Office lock files
~$*
*:Zone.Identifier

# backend/data holds several hundred megabytes of raw source files and a
# generated database. Only the compressed tables the image needs get through.
# (Docker's matcher requires the dir/* + !dir/file form.)
#
# The two heavy sources are included in their zstd form: ~33 MB, against the
# ~520 MB their SQLite tables would add. The image serves their exports by
# streaming straight out of these files.
backend/data/*
!backend/data/metadata.csv.zst
!backend/data/chord.csv.zst
!backend/data/amr-rgi-consensus.csv.zst
!backend/data/cazyme.csv.zst
!backend/data/amp_all.csv.zst
!backend/data/cctyper.csv.zst
!backend/data/acp_all.csv.zst
!backend/data/cgc.tsv.zst
!backend/data/cgc.tsv
!backend/data/gfpr.derived.json.zst
!backend/data/family_assigned.csv.zst
!backend/data/merged_pfam_kofam.csv.zst
